# ===================================================================
# StressLess Platform - Master .gitignore
# ===================================================================

# Compiled Java / Maven
**/target/
**/*.class
**/*.jar
**/*.war
**/*.nar
**/*.ear
**/*.zip
**/*.tar.gz
**/*.rar

# Node / Angular
**/node_modules/
**/dist/
**/.angular/
**/.angular/cache
**/out-tsc/
**/tmp/
**/bazel-out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# IDE & Editor files
.idea/
*.iml
.project
.classpath
.settings/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# Logs
logs/
*.log

# OS & Environment
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
*.swp
*.swo
*~

# Secrets & Environment variables (protecting local credentials)
.env
.env.local
*.private
